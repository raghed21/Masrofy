@model Masrofy.BLL.Models.PlanVM
@{
    ViewData["Title"] = "Generate new plan";
}

<!--begin::Form Validation-->
<div class="card card-info card-outline mb-4">
    <!--begin::Header-->
    <div class="card-header">
        <div class="card-title">Income division</div>
    </div>
    <!--end::Header-->
    <!--begin::Form-->
    <form class="needs-validation" asp-action="Create" asp-controller="Plan" method="post">
        <!--begin::Body-->
        <div class="card-body">
            <!--begin::Row-->
            <div class="row g-3">
                <!--begin::Col-->
                <div class="col-md-6">
                    <label asp-for="Income" class="form-label">Input your Income</label>
                    <input asp-for="Income" type="text" class="form-control" />
                    <div class="valid-feedback">Looks good!</div>
                </div>
                <!--end::Col-->
            </div>
            <!--end::Row-->
        </div>
        <!--end::Body-->
        <!--begin::Footer-->
        <div class="card-footer">
            <button class="btn btn-info" type="submit">Generate Your Monthly Plan</button>
        </div>
        <!--end::Footer-->
    </form>
    <!--end::Form-->
</div>