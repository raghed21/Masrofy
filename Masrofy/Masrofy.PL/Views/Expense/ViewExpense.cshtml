 @model IEnumerable<Masrofy.BLL.Models.ExpenseVM>;
@{ 
    ViewData["Title"] = "Expenses";
}

        <h3>View All Expenses</h3>

        @* ----------------------------Expenses--------------------------------------- *@
        <!-- /.card -->
        <div class="col-md-11">

            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title fw-bold">All Your Expenses</h3>
                </div>
                <!-- /.card-header -->
                <div class="card-body p-0 table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr class="text-center">
                                <th style="width: 10px">#</th>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody class="text-center">
                            @{
                                int count = 0;
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-danger text-center fw-bold">No Expenses</td>
                                </tr>
                            }
                            else

                                foreach (var Item in Model)
                                {
                                    count++;
                                    <tr class="align-middle">
                                        <td>@count</td>
                                        <td>@Item.Date</td>
                                        <td>@Item.Type</td>
                                        <td>@Item.Amount</td>

                                    </tr>
                                }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
